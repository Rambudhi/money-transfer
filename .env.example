APP_NAME=money-transfer
APP_VERSION=1.0.0
APP_MODE=development
APP_ADDRESS=0.0.0.0
APP_PORT=8090
TZ=Asia/Jakarta

# PostgreSQL
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=postgres
POSTGRESQL_DB=money_transfer
POSTGRESQL_HOST=localhost
POSTGRESQL_SCHEMA=public
POSTGRESQL_PORT=5432
POSTGRESQL_MIN_IDLE_CONNECTIONS=2
POSTGRESQL_MAX_OPEN_CONNECTIONS=10
POSTGRESQL_MAX_LIFETIME=30
POSTGRESQL_LOG_MODE=false

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# LOAD TEST
LOAD_TEST_BASE_URL=http://localhost:8090
LOAD_TEST_MERCHANT_ID=1
LOAD_TEST_AMOUNT=1000
LOAD_TEST_DESTINATION_ACCOUNT=1234567890
LOAD_TEST_REQUESTS=10000
LOAD_TEST_CONCURRENCY=100